{
    "non_root_user": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "remoteUser": "vscode",
        "features": {
            "claude-code-persistence": {}
        }
    },
    "existing_claude_config_dir": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "containerEnv": {
            "CLAUDE_CONFIG_DIR": "/tmp/claude-custom"
        },
        "features": {
            "claude-code-persistence": {}
        }
    }
}
